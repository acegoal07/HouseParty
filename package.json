{
  "devDependencies": {
    "copy-webpack-plugin": "^13.0.1",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "scripts": {
    "build:js": "webpack --config webpack.build.js",
    "build:css": "sass src/assets/scss/style.scss src/assets/css/style-min.css --no-source-map --style=compressed",
    "build:css:watch": "sass --watch src/assets/scss/style.scss src/assets/css/style-min.css --no-source-map --style=compressed",
    "build:all": "npm run build:js && npm run build:css",
    "package": "webpack --config webpack.package.js",
    "build+package": "npm run build:all && npm run package"
  }
}
